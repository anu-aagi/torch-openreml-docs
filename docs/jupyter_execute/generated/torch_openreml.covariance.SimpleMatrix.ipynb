    "import torch\n",
    "from torch_openreml.covariance import SimpleMatrix\n",
    "\n",
    "def my_v(free_params):\n",
    "    return torch.diag(free_params)\n",
    "\n",
    "mat = SimpleMatrix(num_free_params=3, call=my_v)\n",
    "mat(torch.tensor([1.0, 2.0, 3.0]))"
   ]
