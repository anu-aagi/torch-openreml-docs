    "import torch\n",
    "from torch_openreml.covariance import ScalarMatrix, DiagonalMatrix, BlockDiagonal\n",
    "\n",
    "block = BlockDiagonal(\n",
    "    residual=ScalarMatrix(3),\n",
    "    random=DiagonalMatrix(2)\n",
    ")\n",
    "free_params = torch.tensor([0.5, 0.0, 1.0])\n",
    "block(free_params)"
   ]
